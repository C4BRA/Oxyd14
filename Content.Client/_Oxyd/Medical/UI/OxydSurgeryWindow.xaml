<controls:FancyWindow xmlns="https://spacestation14.io"
               xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
               Title="{Loc 'oxyd-surgery-window-title'}"
               MinSize="720 480"
               SetSize="780 560">
    <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="6">
        <RichTextLabel Name="PatientLabel" HorizontalExpand="True"/>
        <RichTextLabel Name="ToolLabel" StyleClasses="LabelSubText" HorizontalExpand="True"/>
        <BoxContainer Orientation="Horizontal" SeparationOverride="8" VerticalExpand="True">
            <!-- Left: organ cards (Eris surgery_organ.tmpl contents column) -->
            <ScrollContainer SetWidth="320" VerticalExpand="True" HScrollEnabled="False">
                <BoxContainer Name="OrganCards" Orientation="Vertical" SeparationOverride="6" HorizontalExpand="True" Margin="0 0 10 0"/>
            </ScrollContainer>
            <!-- Right: selected organ diagnostics / volume / conditions -->
            <BoxContainer Orientation="Vertical" SeparationOverride="6" HorizontalExpand="True">
                <PanelContainer StyleClasses="BackgroundPanelDark">
                    <BoxContainer Orientation="Vertical" SeparationOverride="4" Margin="6">
                        <Label Text="{Loc 'oxyd-surgery-diagnostics'}" StyleClasses="LabelHeading"/>
                        <Label Name="DiagOrganLabel" StyleClasses="LabelSubText"/>
                        <BoxContainer Orientation="Horizontal" SeparationOverride="6">
                            <Label Text="{Loc 'oxyd-surgery-health'}" StyleClasses="LabelKeyText" SetWidth="70"/>
                            <ProgressBar Name="DiagHealthBar" MinValue="0" MaxValue="1" HorizontalExpand="True"/>
                        </BoxContainer>
                        <RichTextLabel Name="DiagStatusLabel" StyleClasses="LabelSubText" HorizontalExpand="True"/>
                        <Label Name="DiagEffLabel"/>
                        <Button Name="DiagnoseButton" Text="{Loc 'oxyd-surgery-diagnose'}"/>
                    </BoxContainer>
                </PanelContainer>
                <PanelContainer StyleClasses="BackgroundPanelDark">
                    <BoxContainer Orientation="Vertical" SeparationOverride="4" Margin="6">
                        <Label Text="{Loc 'oxyd-surgery-volume'}" StyleClasses="LabelHeading"/>
                        <Label Name="VolumeLabel"/>
                        <Button Name="ShrapnelButton" Text="{Loc 'oxyd-surgery-remove-shrapnel'}"/>
                    </BoxContainer>
                </PanelContainer>
                <PanelContainer StyleClasses="BackgroundPanelDark" VerticalExpand="True">
                    <BoxContainer Orientation="Vertical" SeparationOverride="4" Margin="6">
                        <Label Text="{Loc 'oxyd-surgery-conditions'}" StyleClasses="LabelHeading"/>
                        <ScrollContainer VerticalExpand="True" HScrollEnabled="False">
                            <BoxContainer Name="ConditionRows" Orientation="Vertical" SeparationOverride="4" HorizontalExpand="True" Margin="0 0 10 0"/>
                        </ScrollContainer>
                    </BoxContainer>
                </PanelContainer>
            </BoxContainer>
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
