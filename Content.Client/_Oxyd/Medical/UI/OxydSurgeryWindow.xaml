<controls:FancyWindow xmlns="https://spacestation14.io"
               xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
               Title="{Loc 'oxyd-surgery-window-title'}"
               MinSize="520 400"
               SetSize="560 460">
    <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="6">
        <Label Name="PatientLabel"/>
        <Label Name="ToolLabel"/>
        <BoxContainer Orientation="Horizontal" SeparationOverride="8" VerticalExpand="True">
            <ItemList Name="OrganList" HorizontalExpand="True" VerticalExpand="True"/>
            <BoxContainer Orientation="Vertical" SeparationOverride="4" HorizontalExpand="True">
                <RichTextLabel Name="OrganStatusLabel" MinHeight="60"/>
                <BoxContainer Name="StepButtons" Orientation="Vertical" SeparationOverride="4" VerticalExpand="True"/>
            </BoxContainer>
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
