<controls:FancyWindow xmlns="https://spacestation14.io"
               xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
               Title="{Loc 'oxyd-autodoc-window-title'}"
               MinSize="480 420"
               SetSize="520 460">
    <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="6">
        <Label Name="OccupantLabel"/>
        <Label Name="StatusLabel"/>
        <BoxContainer Orientation="Horizontal" SeparationOverride="8" VerticalExpand="True">
            <BoxContainer Name="AvailableSteps" Orientation="Vertical" SeparationOverride="4" HorizontalExpand="True"/>
            <BoxContainer Name="QueueList" Orientation="Vertical" SeparationOverride="4" HorizontalExpand="True"/>
        </BoxContainer>
        <BoxContainer Orientation="Horizontal" SeparationOverride="8">
            <Button Name="StartButton" Text="{Loc 'oxyd-autodoc-start'}"/>
            <Button Name="ClearButton" Text="{Loc 'oxyd-autodoc-clear'}"/>
            <Button Name="EjectButton" Text="{Loc 'oxyd-autodoc-eject'}"/>
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
